<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 https://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="" />
  <group name="General">
    <entry name="noteId" type="String"><default></default></entry>
    <entry name="title" type="String"><default>EQ-Notes</default></entry>
    <entry name="body" type="String"><default></default></entry>
    <entry name="created" type="Int"><default>0</default></entry>
    <entry name="importance" type="Int"><default>1</default></entry>
    <entry name="done" type="Bool"><default>false</default></entry>
    <entry name="palette" type="String"><default>pastel</default></entry>
    <entry name="textColor" type="String"><default>default</default></entry>
    <entry name="radius" type="Int"><default>8</default></entry>
    <entry name="shadow" type="Bool"><default>true</default></entry>
    <entry name="rotation" type="Bool"><default>true</default></entry>
    <entry name="randomOffset" type="Bool"><default>true</default></entry>
  </group>
</kcfg>
